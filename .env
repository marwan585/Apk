# ============================================================
# AeroGrid Backend — Contoh konfigurasi
# Salin file ini menjadi .env lalu isi nilainya
#   cp .env.example .env
# ============================================================

# Port server (cPanel biasanya mengisi PORT otomatis; biarkan bila ragu)
PORT=3000
NODE_ENV=production

# ── Supabase (WAJIB untuk produksi) ─────────────────────────────
# Ambil dari: Supabase Dashboard → Project Settings → API
# Gunakan "service_role" key (rahasia, hanya di server — JANGAN anon key!)
SUPABASE_URL=https://jnaeqntfmrdgyduhcmyu.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_U1GVEy27THSC8vi34vA6-g_yR4L-TH1

# ── Login admin dashboard ───────────────────────────────────────
ADMIN_USERNAME=Marwan
ADMIN_PASSWORD=Marwan

# ── Secret JWT (WAJIB diganti di produksi) ──────────────────────
# Buat acak:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-unik
# Sesi admin permanen: "3650d" (default, 10 tahun) atau "never" = tanpa kedaluwarsa.
JWT_EXPIRES_IN=never

# ── Opsional ────────────────────────────────────────────────────
# Kunci API khusus aplikasi (kosong = tidak dipakai). Bila diisi,
# aplikasi harus mengirim header x-aerogrid-key dengan nilai yang sama.
APP_API_KEY=

# Menit batas dianggap "online"
ONLINE_WINDOW_MINUTES=5

# CORS: * untuk bebas, atau daftar domain dipisah koma
ALLOWED_ORIGINS=*
